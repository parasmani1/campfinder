<% layout('layouts/boilerplate') %>

<h1 class="text-gradient mb-4" style="font-size: 3rem; font-weight: 700;">All Campgrounds</h1>

<h2 class="text-gradient mb-3" style="font-size: 2rem; font-weight: 600;">Filter</h2>

<form class="mb-4">
  <div class="row align-items-end">
    <div class="col-md-4">
      <div class="mb-3">
        <label for="search" class="form-label" style="font-size: 1.1rem; font-weight: 500;">Search</label>
        <input type="text" class="form-control" id="search" name="search" value="<%= search || '' %>" placeholder="Search by title or description">
      </div>
    </div>
    <div class="col-md-2">
      <div class="mb-3">
        <label for="price" class="form-label" style="font-size: 1.1rem; font-weight: 500;">Max Price</label>
        <input type="number" class="form-control" id="price" name="price" value="<%= price || '' %>" placeholder="Max Price" min="0">
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <label for="location" class="form-label" style="font-size: 1.1rem; font-weight: 500;">Location</label>
        <input type="text" class="form-control" id="location" name="location" value="<%= location || '' %>" placeholder="Search by location">
      </div>
    </div>
    <div class="col-md-2">
      <div class="mb-3">
          <label for="sort" class="form-label" style="font-size: 1.1rem; font-weight: 500;">Sort by Price</label>
          <div class="mb-3">
            <select class="form-control" id="sort" name="sort">
                <option value="" <% if (!sort) { %> selected <% } %>>No Sorting</option>
                <option value="asc" <% if (sort === 'asc') { %> selected <% } %>>Low to High</option>
                <option value="desc" <% if (sort === 'desc') { %> selected <% } %>>High to Low</option>
            </select>
        </div>
      </div>
  </div>
    <div class="col-md-2">
        <div class="mb-3">
      <button class="btn btn-gradient btn-block" type="submit" style="font-size: 1.1rem; font-weight: 500;">Filter</button>
    </div>
    </div>
  </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% for(let campground of campgrounds) {%>
    <div class="col mb-4">
      <div class="card rounded-lg shadow h-100">
          <img class="card-img-top rounded-top" alt="" src="<%= campground.images.length ? campground.images[0].url : 'https://res.cloudinary.com/igoswamik/image/upload/v1617456429/YelpCamp/rnxtlbcytd7obessayli.png' %>" crossorigin>
          <div class="card-body d-flex flex-column">
              <h5 class="card-title text-gradient mb-2" style="font-size: 1.3rem; font-weight: 700;"><%= campground.title %></h5>
              <p class="card-text mb-2" style="font-size: 0.9rem; line-height: 1.4;"><%= campground.description.substring(0, 100) %>...</p>
              <p class="mb-1" style="font-size: 0.9rem;">
                  <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                  <span class="text-muted"><%= campground.location %></span>
              </p>
              <p class="mb-3 text-success" style="font-size: 1.1rem; font-weight: 600;">
                  $<%= campground.price %>/day
              </p>
              <a href="/campgrounds/<%= campground._id %>" class="btn btn-gradient mt-auto" style="font-size: 1rem; font-weight: 600;">View Details</a>
          </div>
      </div>
  </div>
  <% } %>
</div>

<style>
  .text-gradient {
    color: linear-gradient(to right, #001427, #0e1b2c, #102f3e, #001d32, #0a242f, #00121d, #001d2d, #0c2c3c, #002339, #072c39);
  }

  .btn-gradient {
    background: linear-gradient(to right, #001427, #0e1b2c, #102f3e, #001d32, #0a242f, #00121d, #001d2d, #0c2c3c, #002339, #072c39);
    color: white;
  }
</style>